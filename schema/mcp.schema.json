{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/axiom-studio/mcps/schema/mcp.schema.json",
  "title": "MCP server catalog entry (servers/<slug>/mcp.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "endpoints"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "x-maxBytes": 256},
    "summary": {"type": "string", "x-maxBytes": 2048},
    "description": {"type": "string", "x-maxBytes": 65536},
    "category": {"type": "string", "pattern": "^[a-z0-9-]{0,64}$"},
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9+#. -]{1,64}$"}
    },
    "official": {"type": "boolean"},
    "registry_name": {"type": "string"},
    "docs_url": {"type": "string", "pattern": "^https?://\\S+$"},
    "website_url": {"type": "string", "pattern": "^https?://\\S+$"},
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "transport", "auth"],
        "properties": {
          "url": {"type": "string", "pattern": "^https://\\S+$"},
          "transport": {"enum": ["streamable-http", "sse"]},
          "auth": {"enum": ["oauth", "api-key", "none", "unknown"]}
        }
      }
    }
  }
}
